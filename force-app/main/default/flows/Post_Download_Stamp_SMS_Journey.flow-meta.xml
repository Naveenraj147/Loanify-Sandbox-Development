    <description>V6-V8- Added &apos;FastPass&apos; contact card send to initial text after download stamp.
V4/V5- All SMS now get sent via Opportunity record for SMS conversation consistency. V5, changed download stamp field to be true datetime field stored on Opportunity object rather than formula field mirroring from Contact object.</description>
    <environments>Default</environments>
    <formulas>
        <name>OneMinuteLater</name>
        <dataType>DateTime</dataType>
        <expression>NOW() + (1 / (24 * 60))</expression>
    </formulas>
    <formulas>
        <name>SMSParams_15Minutes</name>
        <dataType>String</dataType>
        <expression>{!$Record.Id} &amp; &apos;,&apos; &amp; {!$Record.Auto_Shopper__r.MobilePhone} &amp; &apos;,&apos; &amp; {!Get_Message_Template_15Minutes.Id}</expression>
