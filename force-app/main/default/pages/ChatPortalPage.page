    <script>
        function formatTime(dateString) {
            const date = new Date(dateString);
            const options = { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'America/Chicago', timeZoneName: 'short' };
            return date.toLocaleString('en-US', options).replace(',','');
        }
        function scrollToBottom() {
            var conversationPanel = document.getElementById('conversationPanel');
            conversationPanel.scrollTop = conversationPanel.scrollHeight;
        }
        
        // Ensure scrollToBottom is called on initial load
        document.addEventListener("DOMContentLoaded", function() {
        console.log("Data from LWC ==> ", event.data);
            formatMessages();
            scrollToBottom();
        });
        // Ensure scrollToBottom is called after every AJAX request (such as reRender)
        var lexOrigin ="https://loanify--dev--c.sandbox.vf.force.com";

        window.addEventListener("message", function(event) {
                  
            // this.callApex(JSON.stringify(event.data));

            if(event.origin !== lexOrigin){
                //Not the expected origin
                return;
            }
        });



        
        function formatMessages() {
            // const messages = document.querySelectorAll('.chat-message-body');
            // console.log("Inside format Messages");
            // messages.forEach(message => {
            //     const bodyText = message.getAttribute('data-body');
            //     message.innerText = bodyText;
               
            // }); 

            const timeElements = document.querySelectorAll('.chat-message-time');
            timeElements.forEach(timeElement => {
                const originalTime = timeElement.textContent;
                timeElement.textContent = ((formatTime(originalTime)).replace("CDT", "CST")).replace(/^\w{3}\s/, '');;
                
            });
    }
    function handleKeyPress() {
        // Check if the key pressed is Enter
         if (event.key === 'Enter') {
             
             if (event.shiftKey) {
                    // Allow newline by default behavior
                    return true;
                 }
             else{
                showBlackout();
                event.preventDefault(); // Prevent the default Enter key behavior
                console.log('user pressed Enter Key');
                const textAreaInput2 = document.getElementById('j_id0:chatForm:messageTextarea');
                console.log('textAreaInput2  ', textAreaInput2.value);
                sendMessage();
            }
         }
       
    }
    function qusButtonClick(event,button) {
            event.preventDefault();
            console.log('Inside qusButtonClick');
            const buttonName = button.name;
            if(buttonName == "Yes"){
                console.log('Yes Button Clicked');
                handleYesResponse();
                return false;
            }
            else{
                console.log('No Button Clicked');
                showBlackout();
                handleNoResponse();
                return false;
            }
        }

        function validateAndSend() {
            const textarea = document.getElementById('j_id0:chatForm:messageTextarea');
            if (!textarea || textarea.value.trim() === '') {
                alert('Please enter a message before sending.');
                return false;
            }
            showBlackout();
            console.log('Sending message');
            return true; // Allow the form submission to proceed
        }
        
        function validateNumberInput(event) {
            // Allow: backspace, delete, tab, escape, enter, decimal point, and numbers
            if (event.keyCode === 46 || event.keyCode === 8 || event.keyCode === 9 || event.keyCode === 27 || event.keyCode === 13 || 
                event.keyCode === 110 || event.keyCode === 190 || 
                (event.keyCode >= 48 && event.keyCode <= 57) || 
                (event.keyCode >= 96 && event.keyCode <= 105)) {
                
                // Check for decimal point
                if (event.keyCode === 110 || event.keyCode === 190) {
                    const input = event.target.value;
                    if (input.indexOf('.') !== -1) {
                        // Already has a decimal point
                        return false;
                    }
                }
                
                // Ensure only two decimal places
                if (event.target.value.indexOf('.') !== -1) {
                    const decimalPart = event.target.value.split('.')[1];
                    if (decimalPart && decimalPart.length >= 2 && 
                        !(event.keyCode === 8 || event.keyCode === 46 || event.keyCode === 9 || event.keyCode === 27 || event.keyCode === 13)) {
                        return false;
                    }
                }
                
                return true;
            }
            
            // Block all other keys
            return false;
        }
        function formatNumberWithCommas(input) {
            let value = input.value.replace(/[^0-9.]/g, '');
            let parts = value.split('.');
            let integerPart = parts[0];
            let decimalPart = parts.length > 1 ? '.' + parts[1] : '';
            integerPart = integerPart.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
            input.value = integerPart + decimalPart;
            let valueInputButton = document.getElementById('j_id0:chatForm:priceSubmitButton');
            valueInputButton.disabled = false;
            input.style.border = "2px solid green";
        }

        function validateInput(input){
            let valueInput = document.getElementById('j_id0:chatForm:priceInput');
            valueInput.value = valueInput.value.replace(/,/g, '');
            if(valueInput.value <= 0 ){
                valueInput.style.border = "2px solid red";
                valueInput.placeholder = "Please enter a value";
                valueInput.classList.add("error-placeholder");
            }
            else{
                showBlackout();
                submitPrice();
            }
           
            
            
            
        }

      function showBlackout() {
        document.getElementById('blackout').style.display = 'block';
    }

    </script>
